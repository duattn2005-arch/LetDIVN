# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for "Sign in with Google".
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID of type "Web application"
# 3. Add your site's domain (and http://localhost:5173 for local dev) under
#    "Authorized JavaScript origins"
# 4. Paste the generated Client ID below (looks like xxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=""

# VITE_FACEBOOK_APP_ID: App ID for "Login with Facebook".
# 1. Go to https://developers.facebook.com/apps and create an app (type: Consumer)
# 2. Add the "Facebook Login" product
# 3. Under Facebook Login > Settings, add your site's domain (and
#    http://localhost:5173 for local dev) to "Allowed Domains for the JavaScript SDK"
# 4. Paste the App ID below (numeric)
VITE_FACEBOOK_APP_ID=""

# VITE_ADMIN_EMAILS: comma-separated list of the ONLY emails allowed to receive the
# Admin role (via Google, Facebook, or email login). This is the single gate for
# admin access — nobody else can grant themselves admin from the site UI.
# Example: VITE_ADMIN_EMAILS="you@gmail.com,coadmin@letsdoitvietnam.org"
VITE_ADMIN_EMAILS=""

# VITE_EMAILJS_SERVICE_ID / VITE_EMAILJS_TEMPLATE_ID / VITE_EMAILJS_PUBLIC_KEY:
# Powers "Forgot Password" — sends the 6-digit reset code straight from the
# browser via EmailJS (no backend needed).
# 1. Create a free account at https://www.emailjs.com (200 emails/month free)
# 2. Email Services -> Add New Service -> connect your Gmail (or any SMTP inbox)
#    -> copy the "Service ID"
# 3. Email Templates -> Create New Template. Set the "To email" field to
#    {{to_email}}, and use these variables in the subject/body:
#      Subject: Mã đặt lại mật khẩu Let's do it! Vietnam
#      Body:    Xin chào {{to_name}}, mã xác nhận đặt lại mật khẩu của bạn là: {{code}}
#               (Mã có hiệu lực trong 15 phút.)
#    -> copy the "Template ID"
# 4. Account -> General -> copy the "Public Key"
# 5. Paste all three values below
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""


