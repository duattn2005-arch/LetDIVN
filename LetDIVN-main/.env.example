# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DECAP_GITHUB_CLIENT_ID / DECAP_GITHUB_CLIENT_SECRET: GitHub login for the
# Decap CMS editor at /admin (see server/routes/decapAuth.ts).
# 1. Go to https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# 2. Homepage URL:               https://letsdoitvietnam.online
#    Authorization callback URL: https://letsdoitvietnam.online/api/decap/callback
# 3. Copy the Client ID, then "Generate a new client secret"
# Only GitHub accounts with write access to the repo can publish articles —
# add editors under the repo's Settings -> Collaborators.
DECAP_GITHUB_CLIENT_ID=""
DECAP_GITHUB_CLIENT_SECRET=""

# DECAP_ADMIN_USERNAME / DECAP_ADMIN_PASSWORD / DECAP_ADMIN_GITHUB_TOKEN:
# a shared username + password login for /admin, so editors need no GitHub
# account. On success the server hands Decap DECAP_ADMIN_GITHUB_TOKEN, and every
# save is committed as that token's owner. Create the token at
# https://github.com/settings/personal-access-tokens/new -> Fine-grained,
# Repository access: only duattn2005-arch/LetDIVN, Permissions -> Contents:
# Read and write. Leave the password empty to use GitHub login only.
DECAP_ADMIN_USERNAME="admin"
DECAP_ADMIN_PASSWORD=""
DECAP_ADMIN_GITHUB_TOKEN=""

# CMS_GITHUB_TOKEN (optional): the server reads CMS content (news, videos,
# partners, ...) from GitHub's API. It authenticates with the Decap OAuth App
# above (5000 requests/hour), so this is only needed if those are not set.
CMS_GITHUB_TOKEN=""
